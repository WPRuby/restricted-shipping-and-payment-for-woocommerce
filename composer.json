{
    "name": "wpruby/restricted-shipping-and-payment-for-woocommerce",
    "description": "Add conditions and rules to enable/disable your WooCommerce shipping methods and Payment gateways.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/extension-installer": "^1.4",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "php-stubs/woocommerce-stubs": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "WPRuby\\RestrictedShippingPaymentLite\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/helpers/"
        ]
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "7.4.33"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G"
    }
}
